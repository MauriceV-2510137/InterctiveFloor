<Window x:Class="Microsoft.Samples.Kinect.ControlsBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Living Room Kinect" Width="1280" Height="720" Background="Black"
        KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Viewbox Stretch="Uniform">
        <!-- Logical stage 1280x720: calibration targets and game use these coordinates -->
        <Canvas x:Name="Stage" Width="1280" Height="720" />
    </Viewbox>
</Window>
