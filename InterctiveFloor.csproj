<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Microsoft.Samples.Kinect.ControlsBasics</RootNamespace>
    <AssemblyName>LivingRoomKinect</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- If these versions are not found, pick any 4.x version in NuGet (keep both the same) -->
    <PackageReference Include="Emgu.CV" Version="4.5.5.4823" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.5.5.4823" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.Kinect">
      <!-- KINECTSDK10_DIR is set by the Kinect SDK 1.8 installer -->
      <HintPath>$(KINECTSDK10_DIR)Assemblies\Microsoft.Kinect.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
